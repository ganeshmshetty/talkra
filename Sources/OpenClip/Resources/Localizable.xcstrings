    "Turn an action off to disable it. Open one to change its name, icon, shortcut and options.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭动作以将其停用。打开操作可更改其名称、图标、快捷键和选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉動作以將其停用。打開操作可更改其名稱、圖示、快捷鍵和選項。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez une action pour la suspendre. Ouvrez-en une pour modifier son nom, son icône, son raccourci et ses options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションをオフにして無効化します。開くと名前、アイコン、ショートカット、オプションを変更できます。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings → Apple Intelligence & Siri, or configure another provider in Preferences → AI.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → Apple Intelligence 与 Siri 中开启 Apple Intelligence，或在偏好设置 → AI 中配置其他提供方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→「Apple Intelligence 與 Siri」中開啟 Apple Intelligence，或至「偏好設定」→「AI」設定其他提供者。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Réglages Système → Apple Intelligence et Siri, ou configurez un autre fournisseur dans Préférences → IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → Apple Intelligence と Siri でApple Intelligenceをオンにするか、環境設定 → AI で別のプロバイダを設定してください。"
          }
        }
      }
    },
