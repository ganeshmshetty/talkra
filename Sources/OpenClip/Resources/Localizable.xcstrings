    "Drag to reorder. To move a preset to the top level, drag it out of AI Tools in the Actions list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。要将预设移到顶层，请在操作列表中将其拖出 AI 工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳以重新排序。若要將預設移至最上層，請在動作列表中將其拖出 AI 工具。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Pour déplacer un préréglage au niveau supérieur, faites-le glisser hors des outils IA dans la liste des actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。プリセットをトップレベルに移動するには、アクション一覧の AI ツールから外へドラッグしてください。"
          }
        }
      }
    },
