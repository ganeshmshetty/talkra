    "Rewrite": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改寫"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リライト"
          }
        }
      }
    },
    "Rewrite for clarity and natural flow. Preserve the meaning, factual details, intent, and original language. Do not add new claims. Return only the rewritten text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写文本，使其清晰、自然流畅。保留含义、事实细节、意图和原始语言。不要添加新的主张。只返回改写后的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改寫文字，使其清楚、自然流暢。保留含義、事實細節、意圖和原始語言。不要加入新的主張。只回傳改寫後的文字。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrire pour améliorer la clarté et la fluidité. Préserver le sens, les détails factuels, l’intention et la langue d’origine. Ne pas ajouter de nouvelles affirmations. Renvoyer uniquement le texte réécrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確で自然な流れになるように書き直してください。意味、事実の詳細、意図、元の言語を維持し、新たな主張を加えないでください。書き直したテキストのみを返してください。"
          }
        }
      }
    },
    "Rewrite in a professional, formal tone. Preserve meaning, intent, factual details, and language. Avoid inflated wording and unnecessary length. Return only the rewritten text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以专业、正式的语气改写。保留含义、意图、事实细节和语言。避免夸张措辞和不必要的篇幅。只返回改写后的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以專業、正式的語氣改寫。保留含義、意圖、事實細節和語言。避免誇大措辭和不必要的篇幅。只回傳改寫後的文字。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrire dans un ton professionnel et formel. Préserver le sens, l’intention, les détails factuels et la langue. Éviter les formulations pompeuses et la longueur inutile. Renvoyer uniquement le texte réécrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専門的でフォーマルな語調に書き直してください。意味、意図、事実の詳細、言語を維持してください。大げさな表現や不要な長さを避けてください。書き直したテキストのみを返してください。"
          }
        }
      }
    },
    "Rewrite, summarize, translate or ask about the selected text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对选中的文本进行改写、总结、翻译或提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對選取的文字進行改寫、摘要、翻譯或提問。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrivez, résumez, traduisez ou interrogez le texte sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを書き換え、要約、翻訳、または質問します。"
          }
        }
      }
    },
