    },
    "Run custom actions by voice using their name or alias, or assign a global hotkey to trigger them anytime.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过语音说出自定义动作的名称或别名即可运行，也可指定全局快捷键随时触发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過語音說出自訂動作的名稱或別名即可執行，也可指定全域快速鍵隨時觸發。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez des actions personnalisées à la voix en utilisant leur nom ou leur alias, ou attribuez un raccourci global pour les déclencher à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムアクションの名前またはエイリアスを音声で伝えて実行するか、グローバルホットキーを割り当てていつでも呼び出せます。"
          }
        }
      }
    },
