    "Highlighted text stays on your Mac by default. Talkra never collects background data, and only transmits text when you explicitly invoke cloud AI or browser actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中的文本默认保留在你的 Mac 上。Talkra 不会在后台收集数据，仅在你明确调用云端 AI 或浏览器动作时才会传输文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取的文字預設保留在你的 Mac 上。Talkra 絕不會在背景收集資料，只有在明確叫用雲端 AI 或瀏覽器動作時才會傳輸文字。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné reste sur votre Mac par défaut. Talkra ne collecte jamais de données en arrière-plan et ne transmet du texte que lorsque vous déclenchez explicitement des actions d’IA cloud ou de navigateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたテキストはデフォルトでお使いのMac内にとどまります。Talkraがバックグラウンドでデータを収集することはなく、クラウドAIやブラウザアクションを明示的に実行した場合にのみテキストを送信します。"
          }
        }
      }
    },
    "Hold to speak a command about the selected text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按键，说出针对选中文本的指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按鍵，說出針對選取文字的指令。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche pour dicter une commande sur le texte sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押したまま、選択したテキストに関するコマンドを話してください。"
          }
        }
      }
    },
